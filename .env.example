# Exemplo de configuração de ambiente do ATS Match 4All.
# Copie para `.env` e preencha com os valores do seu projeto.
# NUNCA versione o arquivo `.env` real.

# Endereço do backend (banco de dados, autenticação e armazenamento)
SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública (publishable) — segura para uso no navegador
SUPABASE_PUBLISHABLE_KEY="sb_publishable_exemplo"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_exemplo"
SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# As chaves sensíveis (chave administrativa e chave da IA) NÃO ficam em arquivos:
# são configuradas como segredos da plataforma e lidas apenas no servidor.
